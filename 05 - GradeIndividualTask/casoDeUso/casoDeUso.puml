@startuml
left to right direction

actor Cliente
actor Atendente
actor Gerente

Atendente <|-- Gerente

rectangle Sistema {
  usecase "Consultar cardápio" as UC1
  usecase "Registrar pedido" as UC2
  usecase "Calcular total do pedido" as UC3
  usecase "Finalizar pedido" as UC4
  usecase "Registrar pagamento" as UC5
  usecase "Calcular troco" as UC6
  usecase "Emitir comprovante" as UC7
  usecase "Cancelar pedido" as UC8

  usecase "Cadastrar produto" as UC9
  usecase "Alterar preço" as UC10
  usecase "Atualizar estoque" as UC11
  usecase "Remover produto do cardápio" as UC12
  usecase "Consultar vendas realizadas" as UC13
}

Cliente --> UC1
Cliente --> UC2
Cliente --> UC5

Atendente --> UC1
Atendente --> UC2
Atendente --> UC4
Atendente --> UC5
Atendente --> UC7
Atendente --> UC8

Gerente --> UC9
Gerente --> UC10
Gerente --> UC11
Gerente --> UC12
Gerente --> UC13

UC4 ..> UC3 : <<include>>
UC4 ..> UC5 : <<include>>
UC5 ..> UC7 : <<include>>
UC6 ..> UC5 : <<extend>>

@enduml